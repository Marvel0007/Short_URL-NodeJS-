<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f4f4;
        }

        .container {
            width: 400px;
            background: white;
            padding: 35px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        label {
            font-weight: 500;
        }

        input {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        button {
            padding: 12px;
            border: none;
            background: black;
            color: white;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
        }

        button:hover {
            opacity: 0.9;
        }

        .error {
            color: red;
            text-align: center;
            margin-bottom: 10px;
        }

        .link {
            margin-top: 15px;
            text-align: center;
        }

        .link a {
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Login</h1>

        <% if (locals.error) { %>
            <p class="error">
                <%= error %>
            </p>
        <% } %>

        <form action="/user/login" method="POST">

            <div>
                <label>Email</label>
                <input
                    type="email"
                    required
                    name="email"
                    placeholder="Enter your email"
                />
            </div>

            <div>
                <label>Password</label>
                <input
                    type="password"
                    required
                    name="password"
                    placeholder="Enter your password"
                />
            </div>

            <button type="submit">
                Login
            </button>

        </form>

        <div class="link">
            <p>
                Don't have an account?
                <a href="/signup">Signup</a>
            </p>
        </div>

    </div>

</body>

</html>