<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>URL Shortener</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f4f4;
            padding: 40px;
        }

        .container {
            max-width: 900px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
        }

        h1 {
            margin-bottom: 20px;
            text-align: center;
        }

        form {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
        }

        input {
            flex: 1;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        button {
            padding: 12px 20px;
            border: none;
            background: black;
            color: white;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            opacity: 0.9;
        }

        .generated-url {
            margin-bottom: 20px;
            padding: 15px;
            background: #e8f5e9;
            border-radius: 6px;
        }

        .generated-url a {
            text-decoration: none;
            word-break: break-all;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #f0f0f0;
        }

        tr:nth-child(even) {
            background: #fafafa;
        }

        .empty {
            text-align: center;
            margin-top: 20px;
            color: gray;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>🔗 URL Shortener</h1>

        <!-- Generated URL -->
        <% if (locals.id) { %>
            <div class="generated-url">
                <strong>Short URL:</strong>
                <a href="<%= id %>" target="_blank">
                    <%= id %>
                </a>
            </div>
        <% } %>

        <!-- URL Form -->
        <form method="POST" action="/url">
            <input
                type="text"
                name="url"
                placeholder="Enter your URL..."
                required
            />

            <button type="submit">
                Generate
            </button>
        </form>

        <!-- URL Table -->
        <% if (locals.urls && urls.length > 0) { %>

            <table>
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Short URL</th>
                        <th>Original URL</th>
                        <th>Clicks</th>
                    </tr>
                </thead>

                <tbody>
                    <% urls.forEach((url, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>

                            <td>
                                <a
                                    href="https://short-url-node-js-tgnz.vercel.app/<%= url.shortId %>"
                                    target="_blank"
                                >
                                    <%= url.shortId %>
                                </a>
                            </td>

                            <td>
                                <%= url.redirectURL %>
                            </td>

                            <td>
                                <%= url.visitHistory.length %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

        <% } else { %>

            <p class="empty">
                No URLs Generated Yet
            </p>

        <% } %>

    </div>

</body>

</html>